---
import BaseLayout from '../layouts/BaseLayout.astro';
import ModelTree from '../components/ModelTree.astro';
import RootedIn from '../components/RootedIn.astro';
import ClosingQuote from '../components/ClosingQuote.astro';
import Decor from '../components/Decor.astro';
import Icon from '../components/Icon.astro';
import { Image } from 'astro:assets';
import { modelTitle, modelIntro } from '../data/model';
import { approach } from '../data/content';
import { creativePhoto } from '../data/photos';

// Suggested section from the wireframe — steps to be confirmed with Shelley.
const steps = [
	{ title: 'Referral', body: 'Parents, carers, young people, schools and local authorities can all get in touch.', todo: false },
	{ title: 'Getting to know you', body: '[Initial meeting with young person and family]', todo: true },
	{ title: 'Mentor matching', body: '[Trauma-informed matching process]', todo: true },
	{ title: 'Sessions begin', body: '[Flexible, home-based or nature-based sessions]', todo: true },
];
---

<BaseLayout title="Our Model" description={modelTitle}>
	<section class="head wrap" data-reveal>
		<div class="eyebrow">Our Model</div>
		<h1>{modelTitle}</h1>
		<Decor kind="rule" />
		<p class="lede">{modelIntro}</p>
	</section>

	<section class="wrap tree-section" aria-label="The support around each young person">
		<p class="hint" data-reveal>Select an area to see how we help.</p>
		<ModelTree expandable />
	</section>

	<section class="sessions wrap" aria-labelledby="sessions-title">
		<div class="sessions-photo" data-reveal>
			<Image src={creativePhoto.src} alt={creativePhoto.alt} widths={[400, 700, 1000]} sizes="(max-width: 860px) 90vw, 460px" />
		</div>
		<div class="sessions-text" data-reveal style="--d: 150ms">
			<div class="eyebrow">My approach</div>
			<h2 id="sessions-title">Blending practical and holistic support</h2>
			<Decor kind="rule" />
			<p class="lede">{approach.intro}</p>
			<h3>{approach.sessionsTitle}</h3>
			<ul class="session-list">
				{approach.sessions.map((item) => <li>{item}</li>)}
			</ul>
			<p class="script outro">{approach.sessionsOutro}</p>
		</div>
	</section>

	<section class="flex-model">
		<div class="wrap">
			<div class="flex-head" data-reveal>
				<h2>{approach.flexibleTitle}</h2>
				<p class="lede">{approach.flexible}</p>
			</div>
			<ul class="principles" data-stagger>
				{
					approach.principles.map((pr) => (
						<li>
							<span class="icon-dot">
								<Icon name={pr.icon} />
							</span>
							<h3>{pr.title}</h3>
							<p>{pr.body}</p>
						</li>
					))
				}
			</ul>
		</div>
	</section>

	<section class="why wrap" aria-labelledby="why-title" data-reveal>
		<div class="eyebrow">Why it matters</div>
		<h2 id="why-title">{approach.whyTitle}</h2>
		<Decor kind="rule" />
		{approach.why.map((para) => <p>{para}</p>)}
	</section>

	<RootedIn band />

	<section class="steps-section wrap" aria-labelledby="how-title">
		<div class="steps-head" data-reveal>
			<div class="eyebrow">How it works</div>
			<h2 id="how-title">From referral to first session</h2>
		</div>
		<ol class="steps" data-stagger>
			{
				steps.map((s, i) => (
					<li>
						<span class="num">{i + 1}</span>
						<h3>{s.title}</h3>
						<p data-todo={s.todo || undefined}>{s.body}</p>
					</li>
				))
			}
		</ol>
	</section>

	<ClosingQuote cta />
</BaseLayout>

<style>
	.head {
		padding-top: clamp(48px, 8vw, 96px);
		padding-bottom: 48px;
		max-width: 860px;
		text-align: center;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 22px;
	}
	.tree-section {
		padding-bottom: var(--section);
	}
	.hint {
		text-align: center;
		font-size: 14px;
		color: var(--olive);
		margin-bottom: 28px;
	}
	.sessions {
		padding-bottom: var(--section);
		display: grid;
		grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
		gap: clamp(40px, 6vw, 80px);
		align-items: center;
	}
	.sessions-photo :global(img) {
		width: 100%;
		aspect-ratio: 4 / 5;
		object-fit: cover;
		border-radius: 48px 220px 48px 220px;
	}
	.sessions-text {
		display: flex;
		flex-direction: column;
		gap: 18px;
	}
	.sessions-text h3 {
		font-family: var(--sans);
		font-size: 13px;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		font-weight: 500;
		margin-top: 8px;
	}
	.session-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 10px;
		color: var(--ink-soft);
	}
	.session-list li {
		padding-left: 28px;
		position: relative;
	}
	.session-list li::before {
		content: '';
		position: absolute;
		left: 4px;
		top: 0.7em;
		width: 10px;
		height: 10px;
		border-radius: 50% 0;
		background: var(--sage);
	}
	.outro {
		font-size: 30px;
		margin-top: 8px;
	}
	.flex-model {
		background: var(--stone);
		padding: var(--section) 0;
		border-radius: 0 clamp(80px, 18vw, 240px) 0 0;
	}
	.flex-head {
		max-width: 820px;
		display: flex;
		flex-direction: column;
		gap: 18px;
		margin-bottom: 48px;
	}
	.principles {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
		gap: 24px;
	}
	.principles li {
		background: var(--cream);
		border-radius: 32px;
		padding: 32px 28px;
		display: flex;
		flex-direction: column;
		gap: 12px;
	}
	.principles h3 {
		font-size: 22px;
	}
	.principles p {
		font-size: 15px;
		color: var(--ink-soft);
	}
	.why {
		max-width: 820px;
		padding-top: var(--section);
		padding-bottom: var(--section);
		display: flex;
		flex-direction: column;
		gap: 18px;
	}
	.why p {
		color: var(--ink-soft);
	}
	@media (max-width: 860px) {
		.sessions {
			grid-template-columns: 1fr;
		}
		.sessions-photo {
			max-width: 380px;
		}
	}
	.steps-section {
		padding-top: var(--section);
		padding-bottom: var(--section);
	}
	.steps-head {
		display: flex;
		flex-direction: column;
		gap: 14px;
		margin-bottom: 48px;
	}
	.steps {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
		gap: 24px;
	}
	.steps li {
		background: var(--stone);
		border-radius: 32px;
		padding: 32px 28px;
		display: flex;
		flex-direction: column;
		gap: 12px;
	}
	.num {
		width: 44px;
		height: 44px;
		border-radius: 50%;
		background: var(--deep-green);
		color: var(--cream);
		display: inline-flex;
		align-items: center;
		justify-content: center;
		font-family: var(--display);
		font-size: 20px;
	}
	.steps h3 {
		font-size: 22px;
	}
	.steps p {
		font-size: 15px;
		color: var(--ink-soft);
	}
</style>
