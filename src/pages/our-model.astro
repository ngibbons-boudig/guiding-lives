---
import BaseLayout from '../layouts/BaseLayout.astro';
import ModelTree from '../components/ModelTree.astro';
import RootedIn from '../components/RootedIn.astro';
import ClosingQuote from '../components/ClosingQuote.astro';
import Decor from '../components/Decor.astro';
import { modelTitle, modelIntro } from '../data/model';

// Suggested section from the wireframe — steps to be confirmed with Shelley.
const steps = [
	{ title: 'Referral', body: '[Who can refer — school, LA, social care, family]' },
	{ title: 'Getting to know you', body: '[Initial meeting with young person and family]' },
	{ title: 'Mentor matching', body: '[Trauma-informed matching process]' },
	{ title: 'Sessions begin', body: '[Flexible, home-based or nature-based sessions]' },
];
---

<BaseLayout title="Our Model" description={modelTitle}>
	<section class="head wrap">
		<div class="eyebrow">Our Model</div>
		<h1>{modelTitle}</h1>
		<Decor kind="rule" />
		<p class="lede">{modelIntro}</p>
	</section>

	<section class="wrap tree-section" aria-label="The support around each young person">
		<p class="hint">Select an area to see how we help.</p>
		<ModelTree expandable />
	</section>

	<RootedIn band>
		<p class="foundations-note" data-todo>[Short paragraph on each foundation — to be supplied]</p>
	</RootedIn>

	<section class="steps-section wrap" aria-labelledby="how-title">
		<div class="steps-head">
			<div class="eyebrow">How it works</div>
			<h2 id="how-title">From referral to first session</h2>
		</div>
		<ol class="steps">
			{
				steps.map((s, i) => (
					<li>
						<span class="num">{i + 1}</span>
						<h3>{s.title}</h3>
						<p data-todo>{s.body}</p>
					</li>
				))
			}
		</ol>
	</section>

	<ClosingQuote cta />
</BaseLayout>

<style>
	.head {
		padding-top: clamp(48px, 8vw, 96px);
		padding-bottom: 48px;
		max-width: 860px;
		text-align: center;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 22px;
	}
	.tree-section {
		padding-bottom: var(--section);
	}
	.hint {
		text-align: center;
		font-size: 14px;
		color: var(--olive);
		margin-bottom: 28px;
	}
	.foundations-note {
		max-width: 680px;
		text-align: center;
		color: var(--ink-soft);
	}
	.steps-section {
		padding-top: var(--section);
		padding-bottom: var(--section);
	}
	.steps-head {
		display: flex;
		flex-direction: column;
		gap: 14px;
		margin-bottom: 48px;
	}
	.steps {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
		gap: 24px;
	}
	.steps li {
		background: var(--stone);
		border-radius: 32px;
		padding: 32px 28px;
		display: flex;
		flex-direction: column;
		gap: 12px;
	}
	.num {
		width: 44px;
		height: 44px;
		border-radius: 50%;
		background: var(--deep-green);
		color: var(--cream);
		display: inline-flex;
		align-items: center;
		justify-content: center;
		font-family: var(--display);
		font-size: 20px;
	}
	.steps h3 {
		font-size: 22px;
	}
	.steps p {
		font-size: 15px;
		color: var(--ink-soft);
	}
</style>
