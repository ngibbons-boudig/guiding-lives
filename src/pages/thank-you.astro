---
import BaseLayout from '../layouts/BaseLayout.astro';
import Decor from '../components/Decor.astro';
import { strapline } from '../data/model';
---

<BaseLayout title="Thank you" noindex>
	<section class="wrap msg" data-reveal>
		<div class="eyebrow">Message sent</div>
		<h1>Thank you for getting in touch</h1>
		<Decor kind="rule" />
		<p class="lede">We’ll be in touch soon.</p>
		<p class="script tag">{strapline}</p>
		<a class="btn btn-ghost" href="/">Back to home</a>
	</section>
</BaseLayout>

<style>
	.msg {
		padding-top: var(--section);
		padding-bottom: var(--section);
		max-width: 720px;
		text-align: center;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 22px;
	}
	.tag {
		font-size: 36px;
	}
</style>
