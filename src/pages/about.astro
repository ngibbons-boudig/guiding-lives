---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import Decor from '../components/Decor.astro';
import Testimonials from '../components/Testimonials.astro';
import { Image } from 'astro:assets';
import { contact, linkedin } from '../data/site';
import { about, contactCopy } from '../data/content';
import { shelleyPhoto } from '../data/photos';

const roles = [
	'Parent or carer',
	'School or alternative provision',
	'Local Authority / social care',
	'Health professional',
	'Young person',
	'Other',
];
---

<BaseLayout title="About & Contact" description="Meet Shelley: Therapeutic Support Practitioner and mentor with over fifteen years of experience. One-to-one mentoring for young people aged 11 to 18 in Dorset.">
	<section class="about wrap">
		<figure class="portrait" data-reveal>
			<Image src={shelleyPhoto.src} alt={shelleyPhoto.alt} widths={[400, 700, 1000]} sizes="(max-width: 860px) 90vw, 440px" class="portrait-img" loading="eager" />
			<figcaption>Shelley Monk, founder of Guiding Lives</figcaption>
		</figure>
		<div class="bio" data-reveal style="--d: 150ms">
			<div class="eyebrow">About</div>
			<h1>{about.greeting}</h1>
			<Decor kind="rule" />
			<p class="role">{about.role}</p>
			{about.body.map((p, i) => <p class:list={{ lede: i === 0 }}>{p}</p>)}
			<div class="quals">
				<h2 class="eyebrow">Experience and training</h2>
				<ul>
					{about.highlights.map((h) => (
						<li><span class="icon-dot"><Icon name={h.icon} /></span>{h.text}</li>
					))}
				</ul>
			</div>
			<a class="btn btn-ghost" href={linkedin} rel="noopener">View LinkedIn profile</a>
		</div>
	</section>

	<section class="values" aria-labelledby="approach-title">
		<div class="wrap values-head" data-reveal>
			<div class="eyebrow">My approach</div>
			<h2 id="approach-title">Practical guidance and emotional support</h2>
		</div>
		<div class="wrap">
		<ul class="approach-list" data-stagger>
			{
				about.approach.map((v) => (
					<li>
						<span class="icon-dot">
							<Icon name={v.icon} />
						</span>
						<h3>{v.title}</h3>
						<p>{v.body}</p>
					</li>
				))
			}
		</ul>
		</div>
		<p class="wrap values-outro" data-reveal>{about.approachOutro}</p>
	</section>

	<Testimonials full only={[1]} />

	<section id="contact" class="contact wrap">
		<div class="contact-text" data-reveal>
			<div class="eyebrow">Contact</div>
			<h2>{contactCopy.title}</h2>
			{contactCopy.body.map((p, i) => <p class:list={{ lede: i === 0 }}>{p}</p>)}
			<ul class="details">
				<li><Icon name="mail" /><a href={`mailto:${contact.email}`}>{contact.email}</a></li>
				<li><Icon name="phone" /><a href={contact.phoneHref}>{contact.phone}</a></li>
				<li><Icon name="pin" /><span>Mentoring across {contact.area}</span></li>
			</ul>
		</div>

		<!--
			Netlify Forms: detected from the built HTML (data-netlify). If the site is
			hosted elsewhere, point `action` at that host's form handler instead.
		-->
		<form data-reveal style="--d: 150ms" class="form" name="contact" method="POST" action="/thank-you/" data-netlify="true" netlify-honeypot="company">
			<input type="hidden" name="form-name" value="contact" />
			<p class="hp" aria-hidden="true"><label>Leave this empty <input name="company" tabindex="-1" autocomplete="off" /></label></p>
			<div class="field">
				<label for="f-name">Your name</label>
				<input id="f-name" name="name" type="text" autocomplete="name" required />
			</div>
			<div class="field">
				<label for="f-email">Email</label>
				<input id="f-email" name="email" type="email" autocomplete="email" required />
			</div>
			<div class="field">
				<label for="f-role">I am a…</label>
				<select id="f-role" name="role">
					{roles.map((r) => <option>{r}</option>)}
				</select>
			</div>
			<div class="field">
				<label for="f-msg">How can we help?</label>
				<textarea id="f-msg" name="message" rows="5" required></textarea>
			</div>
			<button type="submit" class="btn btn-primary">Send message</button>
			<p class="privacy">Your details are only used to reply to your enquiry and are stored securely in line with UK GDPR. See the <a href="/policies/#2-privacy--data-protection-policy">privacy and data protection policy</a>.</p>
		</form>
	</section>
</BaseLayout>

<style>
	.about {
		padding-top: clamp(48px, 8vw, 96px);
		padding-bottom: var(--section);
		display: grid;
		grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
		gap: 64px;
		align-items: start;
	}
	.portrait {
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 14px;
	}
	.portrait :global(.portrait-img) {
		width: 100%;
		aspect-ratio: 4 / 5;
		object-fit: cover;
		border-radius: 200px 200px 48px 48px;
	}
	.portrait {
		position: sticky;
		top: 120px;
	}
	.role {
		font-size: 13px;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		font-weight: 400;
		color: var(--olive) !important;
	}
	figcaption {
		font-size: 14px;
		color: var(--olive);
		align-self: center;
	}
	.bio {
		display: flex;
		flex-direction: column;
		gap: 20px;
		align-items: flex-start;
	}
	.bio p {
		color: var(--ink-soft);
	}
	.quals {
		margin-top: 12px;
		display: flex;
		flex-direction: column;
		gap: 16px;
	}
	.quals h2 {
		font-family: var(--sans);
		font-size: 12px;
	}
	.quals ul,
	.details,
	.approach-list {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.quals ul {
		display: flex;
		flex-direction: column;
		gap: 12px;
	}
	.quals li {
		display: flex;
		align-items: center;
		gap: 16px;
	}

	.values {
		background: var(--stone);
		padding: 80px 0;
		border-radius: clamp(60px, 14vw, 200px) 0 clamp(60px, 14vw, 200px) 0;
	}
	.approach-list {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
		gap: 40px;
	}
	.values li {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		gap: 14px;
	}
	.values .icon-dot {
		background: var(--cream);
	}
	.values h3 {
		font-size: 22px;
	}
	.values-head {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		gap: 14px;
		margin-bottom: 48px;
	}
	.values-outro {
		margin-top: 48px;
		max-width: 760px;
		text-align: center;
		color: var(--ink-soft);
		font-size: 18px;
	}
	.values p {
		color: var(--ink-soft);
	}

	.contact {
		padding-top: var(--section);
		padding-bottom: var(--section);
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		gap: 64px;
		scroll-margin-top: 110px;
	}
	.contact-text {
		display: flex;
		flex-direction: column;
		gap: 20px;
	}
	.details {
		display: flex;
		flex-direction: column;
		gap: 12px;
		margin-top: 8px;
	}
	.details li {
		display: flex;
		align-items: center;
		gap: 12px;
	}

	.form {
		background: var(--stone);
		border-radius: clamp(28px, 4vw, 40px);
		padding: clamp(32px, 4vw, 44px);
		display: flex;
		flex-direction: column;
		gap: 18px;
	}
	.field {
		display: flex;
		flex-direction: column;
		gap: 6px;
	}
	label {
		font-size: 12px;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		font-weight: 400;
	}
	input,
	select,
	textarea {
		font: inherit;
		font-size: 16px;
		color: var(--deep-green);
		background: var(--cream);
		border: 1px solid var(--pale-sage);
		border-radius: 16px;
		padding: 12px 16px;
		width: 100%;
	}
	input:focus,
	select:focus,
	textarea:focus {
		outline: 2px solid var(--deep-green);
		outline-offset: 1px;
		border-color: transparent;
	}
	.form .btn {
		align-self: flex-start;
	}
	.privacy {
		font-size: 13px;
		color: var(--ink-soft);
	}
	.hp {
		position: absolute;
		left: -9999px;
	}

	@media (max-width: 860px) {
		.about,
		.contact {
			grid-template-columns: 1fr;
			gap: 40px;
		}
		.portrait {
			max-width: 360px;
			position: static;
		}
	}
</style>
