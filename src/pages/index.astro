---
import BaseLayout from '../layouts/BaseLayout.astro';
import ModelTree from '../components/ModelTree.astro';
import RootedIn from '../components/RootedIn.astro';
import ClosingQuote from '../components/ClosingQuote.astro';
import Decor from '../components/Decor.astro';
import Icon from '../components/Icon.astro';
import { Image } from 'astro:assets';
import Testimonials from '../components/Testimonials.astro';
import { heroPhoto, shelleyPhoto } from '../data/photos';
import { welcome } from '../data/content';
import { positioning, strapline, modelTitle, modelIntro, moreThanMentoring } from '../data/model';
---

<BaseLayout>
	<!-- Hero photo from the old site: see src/data/photos.ts. -->
	<section class="hero">
		<Image
			src={heroPhoto.src}
			alt={heroPhoto.alt}
			class="hero-photo"
			data-parallax="0.12"
			widths={[640, 1024, 1600, 2400]}
			sizes="100vw"
			loading="eager"
			fetchpriority="high"
		/>
		<div class="hero-card">
			<div class="eyebrow">Youth mentoring support</div>
			<h1>{positioning}</h1>
			<p class="script hero-script">{strapline}</p>
			<div class="actions">
				<a class="btn btn-primary" href="/our-model/">See our model</a>
				<a class="btn btn-ghost" href="/about/#contact">Make a referral</a>
			</div>
		</div>
		<Decor kind="sprig" class="hero-sprig" />
	</section>

	<section class="welcome wrap">
		<div class="welcome-photo" data-reveal>
			<Image src={shelleyPhoto.src} alt={shelleyPhoto.alt} widths={[400, 700, 1000]} sizes="(max-width: 860px) 90vw, 460px" />
			<span class="stat">{welcome.stat}</span>
		</div>
		<div class="welcome-text" data-reveal style="--d: 150ms">
			<div class="eyebrow">{welcome.eyebrow}</div>
			<h2>{welcome.title}</h2>
			<Decor kind="rule" />
			{welcome.body.map((p) => <p class="lede">{p}</p>)}
			<a class="btn btn-ghost" href="/about/">Meet Shelley</a>
		</div>
	</section>

	<section class="intro wrap" data-reveal>
		<div class="eyebrow">Our Model</div>
		<h2>{modelTitle}</h2>
		<Decor kind="rule" />
		<p class="lede">{modelIntro}</p>
	</section>

	<section class="wrap tree-section" aria-label="The support around each young person">
		<ModelTree />
	</section>

	<section class="more">
		<div class="wrap more-inner">
			<div class="more-text" data-reveal>
				<h2 class="more-title">{moreThanMentoring.title}</h2>
				<Decor kind="rule" />
				<p class="lede">{moreThanMentoring.body}</p>
			</div>
			<ul class="more-list" data-stagger>
				{
					moreThanMentoring.items.map((item) => (
						<li>
							<span class="icon-dot">
								<Icon name={item.icon} />
							</span>
							{item.title}
						</li>
					))
				}
			</ul>
		</div>
	</section>

	<RootedIn />

	<Testimonials />

	<ClosingQuote />
</BaseLayout>

<style>
	.hero {
		position: relative;
		min-height: 680px;
		display: flex;
		align-items: center;
		padding: 72px var(--gutter);
		background:
			radial-gradient(ellipse at 70% 40%, rgba(222, 193, 152, 0.35), transparent 55%),
			linear-gradient(180deg, #b9c2b0 0%, #d8dccb 55%, #e9e8da 100%);
		overflow: hidden;
	}
	/* Photo with a warm cream wash, pulling it toward the palette as the brief asks. */
	.hero-photo {
		position: absolute;
		inset: -10% 0;
		width: 100%;
		height: 120%;
		object-fit: cover;
		object-position: left 60%;
		filter: saturate(0.7) sepia(0.12);
	}
	.hero::after {
		content: '';
		position: absolute;
		inset: 0;
		background:
			radial-gradient(ellipse at 70% 40%, rgba(222, 193, 152, 0.25), transparent 55%),
			linear-gradient(90deg, rgba(246, 243, 235, 0.35), rgba(246, 243, 235, 0.05) 60%);
		pointer-events: none;
	}
	.hero-card {
		position: relative;
		z-index: 1;
		max-width: 640px;
		background: rgba(246, 243, 235, 0.92);
		padding: 56px;
		border-radius: 200px 48px 200px 48px;
		display: flex;
		flex-direction: column;
		gap: 22px;
	}
	.hero-script {
		font-size: clamp(32px, 4vw, 40px);
	}
	.actions {
		display: flex;
		gap: 16px;
		flex-wrap: wrap;
		margin-top: 8px;
	}
	:global(.hero-sprig) {
		z-index: 1;
		width: clamp(120px, 17vw, 220px);
		right: 40px;
		bottom: 24px;
		opacity: 0.9;
	}

	.welcome {
		padding-top: var(--section);
		display: grid;
		grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
		gap: clamp(40px, 6vw, 80px);
		align-items: center;
	}
	.welcome-photo {
		position: relative;
	}
	.welcome-photo :global(img) {
		width: 100%;
		aspect-ratio: 4 / 5;
		object-fit: cover;
		border-radius: 220px 220px 48px 48px;
	}
	.stat {
		position: absolute;
		right: -12px;
		bottom: 40px;
		background: var(--deep-green);
		color: var(--cream);
		font-size: 12px;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		padding: 14px 22px;
		border-radius: 999px;
	}
	.welcome-text {
		display: flex;
		flex-direction: column;
		gap: 20px;
		align-items: flex-start;
	}
	.welcome-text h2 {
		font-size: clamp(28px, 3.4vw, 38px);
	}
	@media (max-width: 860px) {
		.welcome {
			grid-template-columns: 1fr;
		}
		.welcome-photo {
			max-width: 380px;
		}
		.stat {
			right: 8px;
		}
	}

	.intro {
		padding-top: var(--section);
		padding-bottom: 56px;
		max-width: 860px;
		text-align: center;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 22px;
	}
	.tree-section {
		padding-top: 40px;
		padding-bottom: var(--section);
	}

	.more {
		background: var(--stone);
		padding: var(--section) 0;
		border-radius: 0 clamp(80px, 18vw, 240px) 0 0;
	}
	.more-inner {
		display: flex;
		gap: 48px 72px;
		flex-wrap: wrap;
		align-items: center;
	}
	.more-text,
	.more-list {
		flex: 1 1 380px;
	}
	.more-text {
		display: flex;
		flex-direction: column;
		gap: 22px;
	}
	.more-title {
		font-family: var(--script);
		font-size: clamp(48px, 6vw, 64px);
		line-height: 1;
	}
	.more-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 20px;
	}
	.more-list li {
		display: flex;
		align-items: center;
		gap: 18px;
		font-size: 18px;
		line-height: 1.4;
	}
	.more-list .icon-dot {
		background: var(--cream);
	}

	@media (max-width: 700px) {
		.hero {
			min-height: 0;
			padding: 120px 16px 72px;
			align-items: flex-end;
		}
		.hero-card {
			padding: 40px 28px;
			border-radius: 120px 32px 32px 32px;
		}
		:global(.hero-sprig) {
			top: 40px;
			bottom: auto;
			right: 8px;
		}
	}
</style>
