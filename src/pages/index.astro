---
import BaseLayout from '../layouts/BaseLayout.astro';
import ModelTree from '../components/ModelTree.astro';
import RootedIn from '../components/RootedIn.astro';
import ClosingQuote from '../components/ClosingQuote.astro';
import Decor from '../components/Decor.astro';
import Icon from '../components/Icon.astro';
import { positioning, strapline, modelTitle, modelIntro, moreThanMentoring } from '../data/model';
---

<BaseLayout>
	<!-- Hero background is a stand-in gradient: swap for the coastal photo from the existing site. -->
	<section class="hero">
		<span class="photo-note" data-todo>Coastal photo — soft light, clifftop and sea</span>
		<div class="hero-card">
			<div class="eyebrow">Youth mentoring support</div>
			<h1>{positioning}</h1>
			<p class="script hero-script">{strapline}</p>
			<div class="actions">
				<a class="btn btn-primary" href="/our-model/">See our model</a>
				<a class="btn btn-ghost" href="/about/#contact">Make a referral</a>
			</div>
		</div>
		<Decor kind="sprig" class="hero-sprig" />
	</section>

	<section class="intro wrap">
		<div class="eyebrow">Our Model</div>
		<h2>{modelTitle}</h2>
		<Decor kind="rule" />
		<p class="lede">{modelIntro}</p>
	</section>

	<section class="wrap tree-section" aria-label="The support around each young person">
		<ModelTree />
	</section>

	<section class="more">
		<div class="wrap more-inner">
			<div class="more-text">
				<h2 class="more-title">{moreThanMentoring.title}</h2>
				<Decor kind="rule" />
				<p class="lede">{moreThanMentoring.body}</p>
			</div>
			<ul class="more-list">
				{
					moreThanMentoring.items.map((item) => (
						<li>
							<span class="icon-dot">
								<Icon name={item.icon} />
							</span>
							{item.title}
						</li>
					))
				}
			</ul>
		</div>
	</section>

	<RootedIn />

	<ClosingQuote />
</BaseLayout>

<style>
	.hero {
		position: relative;
		min-height: 680px;
		display: flex;
		align-items: center;
		padding: 72px var(--gutter);
		background:
			radial-gradient(ellipse at 70% 40%, rgba(222, 193, 152, 0.35), transparent 55%),
			linear-gradient(180deg, #b9c2b0 0%, #d8dccb 55%, #e9e8da 100%);
		overflow: hidden;
	}
	.photo-note {
		position: absolute;
		top: 24px;
		right: var(--gutter);
		font-size: 11px;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: var(--ink-soft);
	}
	.hero-card {
		position: relative;
		max-width: 640px;
		background: rgba(246, 243, 235, 0.92);
		padding: 56px;
		border-radius: 200px 48px 200px 48px;
		display: flex;
		flex-direction: column;
		gap: 22px;
	}
	.hero-script {
		font-size: clamp(32px, 4vw, 40px);
	}
	.actions {
		display: flex;
		gap: 16px;
		flex-wrap: wrap;
		margin-top: 8px;
	}
	:global(.hero-sprig) {
		width: clamp(120px, 17vw, 220px);
		right: 40px;
		bottom: 24px;
		opacity: 0.9;
	}

	.intro {
		padding-top: var(--section);
		padding-bottom: 56px;
		max-width: 860px;
		text-align: center;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 22px;
	}
	.tree-section {
		padding-top: 40px;
		padding-bottom: var(--section);
	}

	.more {
		background: var(--stone);
		padding: var(--section) 0;
		border-radius: 0 clamp(80px, 18vw, 240px) 0 0;
	}
	.more-inner {
		display: flex;
		gap: 48px 72px;
		flex-wrap: wrap;
		align-items: center;
	}
	.more-text,
	.more-list {
		flex: 1 1 380px;
	}
	.more-text {
		display: flex;
		flex-direction: column;
		gap: 22px;
	}
	.more-title {
		font-family: var(--script);
		font-size: clamp(48px, 6vw, 64px);
		line-height: 1;
	}
	.more-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 20px;
	}
	.more-list li {
		display: flex;
		align-items: center;
		gap: 18px;
		font-size: 18px;
		line-height: 1.4;
	}
	.more-list .icon-dot {
		background: var(--cream);
	}

	@media (max-width: 700px) {
		.hero {
			min-height: 0;
			padding: 120px 16px 72px;
			align-items: flex-end;
		}
		.photo-note {
			left: 16px;
			right: auto;
		}
		.hero-card {
			padding: 40px 28px;
			border-radius: 120px 32px 32px 32px;
		}
		:global(.hero-sprig) {
			top: 40px;
			bottom: auto;
			right: 8px;
		}
	}
</style>
