---
/** Long-form text pages written in Markdown (e.g. src/pages/policies.md). */
import BaseLayout from './BaseLayout.astro';
import Decor from '../components/Decor.astro';

const { frontmatter } = Astro.props;
---

<BaseLayout title={frontmatter.title} description={frontmatter.description}>
	<header class="wrap head" data-reveal>
		{frontmatter.eyebrow && <div class="eyebrow">{frontmatter.eyebrow}</div>}
		<h1>{frontmatter.title}</h1>
		<Decor kind="rule" />
	</header>
	<article class="wrap prose" data-reveal>
		<slot />
	</article>
</BaseLayout>

<style>
	.head {
		padding-top: clamp(48px, 8vw, 96px);
		padding-bottom: 40px;
		max-width: 820px;
		display: flex;
		flex-direction: column;
		gap: 18px;
	}
	.prose {
		max-width: 820px;
		padding-bottom: var(--section);
		color: var(--ink-soft);
	}
	.prose :global(h2) {
		font-size: clamp(26px, 3vw, 32px);
		color: var(--deep-green);
		margin: 56px 0 8px;
		padding-top: 32px;
		border-top: 1px solid var(--pale-sage);
	}
	.prose :global(h2:first-child) {
		margin-top: 0;
		padding-top: 0;
		border-top: 0;
	}
	.prose :global(h3) {
		font-family: var(--sans);
		font-size: 12px;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		font-weight: 500;
		color: var(--olive);
		margin: 28px 0 8px;
	}
	.prose :global(p) {
		margin: 0 0 12px;
	}
	.prose :global(ul) {
		margin: 0 0 12px;
		padding-left: 1.2em;
	}
	.prose :global(li) {
		margin-bottom: 4px;
	}
	.prose :global(li::marker) {
		color: var(--sage);
	}
</style>
