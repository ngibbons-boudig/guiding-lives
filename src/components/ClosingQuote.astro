---
import { Image } from 'astro:assets';
import Decor from './Decor.astro';
import { closingPhoto } from '../data/photos';
import { closingLine } from '../data/model';

interface Props {
	cta?: boolean;
}
const { cta = false } = Astro.props;
---

<!-- Backdrop photo from the old site: see src/data/photos.ts. -->
<section class="closing">
	<Image src={closingPhoto.src} alt="" class="closing-photo" data-parallax="0.1" widths={[640, 1024, 1600, 2400]} sizes="100vw" />
	<div class="inner" data-reveal>
		<p class="quote">{closingLine}</p>
		{cta && <a class="btn btn-primary" href="/about/#contact">Make a referral</a>}
	</div>
	<Decor kind="sprig" dark class="closing-sprig" />
</section>

<style>
	.closing {
		position: relative;
		min-height: 380px;
		background: linear-gradient(180deg, #e9e8da 0%, #c9cdb8 60%, #9fa78f 100%);
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 80px var(--gutter);
		border-radius: clamp(80px, 20vw, 260px) 0 0 0;
		overflow: hidden;
	}
	/* Decorative backdrop (alt=""), washed toward cream so the script quote stays legible. */
	.closing-photo {
		position: absolute;
		inset: -20% 0;
		width: 100%;
		height: 140%;
		object-fit: cover;
		object-position: center 75%;
		filter: saturate(0.65) sepia(0.15);
	}
	.closing::after {
		content: '';
		position: absolute;
		inset: 0;
		background: radial-gradient(ellipse at center, rgba(246, 243, 235, 0.88) 0%, rgba(246, 243, 235, 0.6) 55%, rgba(246, 243, 235, 0.25) 100%);
		pointer-events: none;
	}
	.inner {
		position: relative;
		z-index: 1;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 32px;
		max-width: 780px;
		text-align: center;
	}
	.quote {
		font-family: var(--script);
		font-size: clamp(38px, 5.5vw, 56px);
		line-height: 1.15;
		color: var(--deep-green);
	}
	:global(.closing-sprig) {
		z-index: 1;
		width: clamp(110px, 14vw, 180px);
		right: 48px;
		bottom: 16px;
		transform: scaleX(-1);
	}
</style>
