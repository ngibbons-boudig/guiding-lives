---
import { Image } from 'astro:assets';
import symbol from '../assets/brand/symbol.png';
import { strapline } from '../data/model';
import { contact } from '../data/site';
import { safeguardingSummary } from '../data/content';
---

<footer class="site-footer">
	<div class="wrap grid">
		<div class="brand">
			<Image src={symbol} alt="" width={72} height={72} class="mark" densities={[1, 2]} />
			<div class="name">Guiding Lives</div>
			<div class="sub">Youth Mentoring Support</div>
			<p class="script tag">{strapline}</p>
		</div>
		<div>
			<div class="head">Contact</div>
			<p><a href={`mailto:${contact.email}`}>{contact.email}</a></p>
			<p><a href={contact.phoneHref}>{contact.phone}</a></p>
			<p>Mentoring across {contact.area}</p>
		</div>
		<div>
			<div class="head">Safeguarding</div>
			<p>{safeguardingSummary}</p>
			<p><a href="/policies/">Read our mentoring policies</a></p>
		</div>
	</div>
	<div class="wrap legal">© {new Date().getFullYear()} Guiding Lives</div>
</footer>

<style>
	.site-footer {
		background: var(--forest);
		color: var(--pale-sage);
		padding: 64px 0 32px;
		font-size: 14px;
	}
	.grid {
		display: flex;
		flex-wrap: wrap;
		gap: 48px 56px;
	}
	.grid > div {
		flex: 1 1 220px;
		display: flex;
		flex-direction: column;
		gap: 10px;
	}
	.brand {
		flex-basis: 300px !important;
	}
	.mark {
		width: 72px;
		height: 72px;
		border-radius: 50%;
		object-fit: cover;
	}
	.name {
		font-family: var(--display);
		font-size: 22px;
		color: var(--cream);
	}
	.sub {
		font-size: 10px;
		letter-spacing: 0.28em;
		text-transform: uppercase;
	}
	.tag {
		font-size: 30px;
		color: var(--cream);
	}
	.head {
		font-size: 11px;
		letter-spacing: 0.22em;
		text-transform: uppercase;
		color: var(--cream);
		font-weight: 400;
	}
	a {
		color: var(--cream);
		text-decoration-color: rgba(222, 193, 152, 0.6);
	}
	a:hover {
		color: var(--gold);
	}
	.legal {
		margin-top: 48px;
		font-size: 12px;
		color: var(--sage);
	}
</style>
