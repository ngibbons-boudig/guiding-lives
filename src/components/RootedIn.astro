---
import Icon from './Icon.astro';
import { foundations } from '../data/model';

interface Props {
	band?: boolean;
}
const { band = false } = Astro.props;
---

<section class:list={['rooted', { band }]} aria-labelledby="rooted-title">
	<div class="wrap">
		<h2 id="rooted-title" class="eyebrow">Rooted in</h2>
		<ul>
			{
				foundations.map((f) => (
					<li>
						<span class="icon-dot">
							<Icon name={f.icon} />
						</span>
						{f.title}
					</li>
				))
			}
		</ul>
		<slot />
	</div>
</section>

<style>
	.rooted {
		padding: 96px 0;
	}
	.band {
		background: var(--stone);
	}
	.band .icon-dot {
		background: var(--cream);
	}
	.wrap {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 40px;
	}
	h2.eyebrow {
		font-family: var(--sans);
		font-size: 12px;
		letter-spacing: 0.32em;
	}
	ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(7, minmax(0, 1fr));
		gap: 12px;
		width: 100%;
		max-width: 1100px;
	}
	li {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 12px;
		text-align: center;
		font-size: 14px;
		line-height: 1.4;
	}
	@media (max-width: 860px) {
		ul {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 28px 16px;
		}
	}
	@media (min-width: 520px) and (max-width: 860px) {
		ul {
			grid-template-columns: repeat(4, minmax(0, 1fr));
		}
	}
</style>
